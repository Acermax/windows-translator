<Window x:Class="WindowsTranslator.App.Features.Popup.TranslationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Translator"
        Width="440"
        SizeToContent="Height"
        MaxHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="#FAFAFA"
            BorderBrush="#222222"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.24" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel x:Name="HeaderPanel"
                       Grid.Row="0"
                       LastChildFill="True"
                       Background="Transparent"
                       MouseLeftButtonDown="HeaderPanel_MouseLeftButtonDown">
                <Button Content="X"
                        Width="26"
                        Height="26"
                        DockPanel.Dock="Right"
                        Click="CloseButton_Click" />
                <Button Content="..."
                        Width="26"
                        Height="26"
                        Margin="0,0,6,0"
                        DockPanel.Dock="Right"
                        ToolTip="Opciones"
                        Click="OptionsButton_Click" />
                <TextBlock x:Name="StatusTextBlock"
                           FontWeight="SemiBold"
                           FontSize="15"
                           VerticalAlignment="Center"
                           Text="Traduciendo..." />
            </DockPanel>

            <TextBlock x:Name="OriginalTextBlock"
                       Grid.Row="1"
                       Margin="0,10,0,8"
                       Foreground="#666666"
                       TextWrapping="Wrap" />

            <ScrollViewer Grid.Row="2" MaxHeight="290" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TranslationTextBox"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         FontSize="14"
                         AcceptsReturn="True" />
            </ScrollViewer>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="CopyButton"
                        Content="Copiar"
                        MinWidth="82"
                        Margin="0,0,8,0"
                        Click="CopyButton_Click" />
                <Button Content="Cerrar"
                        MinWidth="82"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
